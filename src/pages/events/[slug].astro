---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header";
import Footer from "../../components/layout/Footer.astro";
import Container from "../../components/layout/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import Button from "../../components/ui/Button.astro";
import ShareButtons from "../../components/ui/ShareButtons.astro";
import socialData from "../../data/social.json";
import eventDataJson from "../../data/events/001.json";

// One page is built for every slug returned here.
export function getStaticPaths() {
  return [{ params: { slug: eventDataJson.slug } }];
}

interface AgendaItem {
  time: string;
  title: string;
  type: string;
  speaker?: string;
  abstract?: string;
  items?: string[];
  isOpen?: boolean;
}

const social = socialData as { speakerApplicationForm: string };
const eventData = eventDataJson;
const agenda = eventData.agenda as AgendaItem[];

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Meta descriptions work best under ~160 characters
const shorten = (text: string, max = 155) => {
  if (text.length <= max) return text;
  return text.slice(0, max).replace(/\s+\S*$/, "") + "…";
};

const pageTitle = `${eventData.title} | PersiaJS`;
const metaDescription = shorten(eventData.description);

const iconClass = "w-5 h-5 text-[#FF4500] mr-3 mt-0.5 flex-shrink-0";
const bullet = "text-[#FF4500] mr-3 mt-1";
const cardClass =
  "bg-white rounded-2xl border border-gray-200 p-6 md:p-8 hover:border-orange-200 hover:shadow-lg transition-all duration-300";
const linkClass =
  "text-[#FF4500] hover:text-[#FF5414] font-semibold underline";
---

<BaseLayout title={pageTitle} description={metaDescription}>
  <div class="min-h-screen bg-white">
    <Header client:load currentPath={Astro.url.pathname} />
    <section class="py-20 md:py-32 bg-white">
      <Container>
        <SectionTitle
          as="div"
          label="EVENTS"
          title="Upcoming Event"
          subtitle="Join us for our monthly community meetups"
        />

        <!-- Event Card -->
        <div class="max-w-5xl mx-auto">
          <div
            class="bg-gradient-to-br from-orange-50 to-red-50 rounded-2xl border border-orange-200 p-8 md:p-12 mb-12 shadow-lg"
          >
            <div class="grid md:grid-cols-2 gap-8 mb-8">
              <div>
                <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                  {eventData.title}
                </h1>
                <div class="space-y-3 text-gray-700">
                  <div class="flex items-start">
                    <svg
                      class={iconClass}
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      ></path>
                    </svg>
                    <span class="font-medium">{eventData.date}</span>
                  </div>
                  <div class="flex items-start">
                    <svg
                      class={iconClass}
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path>
                    </svg>
                    <span class="font-medium">{eventData.time}</span>
                  </div>
                  <div class="flex items-start">
                    <svg
                      class={iconClass}
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                      ></path>
                      <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="font-medium">{eventData.location}</span>
                  </div>
                </div>
              </div>
              <div class="flex flex-col justify-center">
                <Button
                  href={eventData.lumaLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="primary"
                  size="lg"
                  class="w-full mb-4"
                >
                  RSVP on Luma
                  <svg
                    slot="right-icon"
                    class="w-5 h-5"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                  </svg>
                </Button>
                <p class="text-sm text-gray-600 text-center mb-4">
                  Registration deadline: November 30th, 2025
                </p>
                <ShareButtons url={shareUrl} title={eventData.title} />
              </div>
            </div>

            <p class="text-gray-700 leading-relaxed text-lg mb-6">
              {eventData.description}
            </p>

            <div class="bg-white rounded-xl p-6 border border-orange-100">
              <h3 class="font-bold text-gray-900 mb-4">What to expect:</h3>
              <ul class="space-y-2">
                {
                  eventData.highlights.map((highlight) => (
                    <li class="flex items-start text-gray-700">
                      <span class={bullet}>•</span>
                      <span>{highlight}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <!-- Agenda -->
          <div class="mb-12">
            <h3 class="text-3xl font-bold text-gray-900 mb-8 text-center">
              Agenda
            </h3>
            <div class="space-y-4">
              {
                agenda.map((item) => (
                  <div class={cardClass}>
                    <div class="flex flex-col md:flex-row gap-4 md:gap-6">
                      <div class="flex-shrink-0">
                        <div class="inline-flex items-center gap-2 bg-orange-100 text-[#FF4500] px-4 py-2 rounded-lg font-semibold">
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          {item.time}
                        </div>
                      </div>
                      <div class="flex-1">
                        <h4 class="text-xl font-bold text-gray-900 mb-3">
                          {item.title}
                        </h4>
                        {item.type === "talk" && item.speaker && (
                          <p class="text-[#FF4500] font-semibold mb-3">
                            Speaker: {item.speaker}
                          </p>
                        )}
                        {item.abstract && (
                          <p class="text-gray-700 leading-relaxed mb-4">
                            {item.abstract}
                          </p>
                        )}
                        {item.items && (
                          <ul class="space-y-2">
                            {item.items.map((subItem) => (
                              <li class="flex items-start text-gray-700">
                                <span class={bullet}>•</span>
                                <span>{subItem}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                        {item.isOpen && (
                          <div class="mt-4">
                            <Button
                              href={social.speakerApplicationForm}
                              target="_blank"
                              rel="noopener noreferrer"
                              variant="outline"
                              size="sm"
                            >
                              Apply to Speak →
                            </Button>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Speakers -->
          <div class="mb-12">
            <h3 class="text-3xl font-bold text-gray-900 mb-8 text-center">
              Speakers
            </h3>
            <div class="grid md:grid-cols-2 gap-6 mb-8">
              {
                eventData.speakers.map((speaker) => (
                  <div class={cardClass}>
                    <h4 class="text-2xl font-bold text-gray-900 mb-2">
                      {speaker.name}
                    </h4>
                    <p class="text-[#FF4500] font-semibold mb-3">
                      {speaker.title}
                    </p>
                    <p class="text-gray-700 leading-relaxed mb-4">
                      {speaker.bio}
                    </p>
                    <div class="mb-3">
                      <span class="text-sm font-medium text-gray-600">Topic:</span>{" "}
                      <span class="text-gray-900 font-semibold">
                        {speaker.topic}
                      </span>
                    </div>
                    <a
                      href={speaker.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-[#FF4500] hover:text-[#FF5414] font-semibold transition-colors duration-300"
                    >
                      LinkedIn Profile
                      <svg
                        class="w-4 h-4 ml-1"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Event Details -->
          <div class="mb-12">
            <h3 class="text-3xl font-bold text-gray-900 mb-8 text-center">
              Event Details
            </h3>
            <div class="bg-white rounded-2xl border border-gray-200 p-6 md:p-8">
              <div class="grid md:grid-cols-2 gap-6">
                {
                  [
                    ["Language:", eventData.eventDetails.language],
                    ["Level:", eventData.eventDetails.level],
                    ["Cost:", eventData.eventDetails.cost],
                    ["Format:", eventData.eventDetails.format],
                    ["Capacity:", eventData.eventDetails.capacity],
                    ["Recording:", eventData.eventDetails.recording],
                  ].map(([label, value]) => (
                    <div>
                      <span class="text-sm font-semibold text-gray-600">
                        {label}
                      </span>{" "}
                      <span class="text-gray-900">{value}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Topics Covered -->
          <div class="mb-12">
            <h3 class="text-3xl font-bold text-gray-900 mb-6 text-center">
              Topics Covered
            </h3>
            <div class="bg-white rounded-2xl border border-gray-200 p-6 md:p-8">
              <ul class="grid md:grid-cols-2 gap-3">
                {
                  eventData.topics.map((topic) => (
                    <li class="flex items-start text-gray-700">
                      <span class={bullet}>•</span>
                      <span>{topic}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <!-- Additional Info -->
          <div
            class="bg-gradient-to-br from-gray-50 to-orange-50 rounded-2xl border border-gray-200 p-6 md:p-8"
          >
            <h3 class="text-2xl font-bold text-gray-900 mb-4">
              Additional Information
            </h3>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start">
                <span class={bullet}>•</span>
                <span>
                  <strong>Event Recording:</strong> The event will be recorded and
                  published on our{" "}
                  <a
                    href="https://www.youtube.com/@persiajs"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}>YouTube channel</a
                  >{" "}
                  within 48 hours
                </span>
              </li>
              <li class="flex items-start">
                <span class={bullet}>•</span>
                <span>
                  <strong>Slides:</strong> Speaker slides will be shared after the
                  event via our Telegram group
                </span>
              </li>
              <li class="flex items-start">
                <span class={bullet}>•</span>
                <span>
                  <strong>Networking:</strong> Join our{" "}
                  <a
                    href="https://t.me/joinchat/BcZHTxkf2MoIC1pHxJ_xSw"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}>Telegram group</a
                  >{" "}
                  for pre and post-event discussions
                </span>
              </li>
              <li class="flex items-start">
                <span class={bullet}>•</span>
                <span>
                  <strong>Future Events:</strong> Stay tuned for our next event
                  announcements
                </span>
              </li>
            </ul>
          </div>
        </div>
      </Container>
    </section>
    <Footer />
  </div>
</BaseLayout>
