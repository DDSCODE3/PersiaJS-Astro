---
import SocialIcon from "./SocialIcon.astro";

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

// Starting links (built from the build-time URL).
// The script below rebuilds them from the real page address in the browser.
const shareLinks: Record<string, string> = {
  x: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  whatsapp: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
  telegram: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
};

const shareButtons = [
  {
    platform: "x",
    label: "X (Twitter)",
    color: "hover:bg-[#1DA1F2] hover:text-white",
    iconColor: "text-[#1DA1F2] group-hover:text-white",
  },
  {
    platform: "facebook",
    label: "Facebook",
    color: "hover:bg-[#1877F2] hover:text-white",
    iconColor: "text-[#1877F2] group-hover:text-white",
  },
  {
    platform: "linkedin",
    label: "LinkedIn",
    color: "hover:bg-[#0A66C2] hover:text-white",
    iconColor: "text-[#0A66C2] group-hover:text-white",
  },
  {
    platform: "whatsapp",
    label: "WhatsApp",
    color: "hover:bg-[#25D366] hover:text-white",
    iconColor: "text-[#25D366] group-hover:text-white",
  },
  {
    platform: "telegram",
    label: "Telegram",
    color: "hover:bg-[#0088CC] hover:text-white",
    iconColor: "text-[#0088CC] group-hover:text-white",
  },
];
---

<div class="mt-6" data-share-root data-title={title}>
  <p class="text-sm font-semibold text-gray-700 mb-3 text-center">
    Share this event:
  </p>
  <div class="flex flex-wrap justify-center gap-3">
    {
      shareButtons.map((button) => (
        <a
          href={shareLinks[button.platform]}
          data-share={button.platform}
          target="_blank"
          rel="noopener noreferrer"
          class={`group flex items-center justify-center w-12 h-12 rounded-xl bg-white border-2 border-gray-200 transition-all duration-300 ${button.color} shadow-md hover:shadow-lg hover:scale-110 focus:outline-none focus:ring-2 focus:ring-[#FF4500] focus:ring-offset-2`}
          aria-label={`Share on ${button.label}`}
        >
          <SocialIcon
            platform={button.platform}
            class={`w-5 h-5 ${button.iconColor} transition-colors duration-300`}
          />
        </a>
      ))
    }
    <button
      type="button"
      data-copy
      class="group flex items-center justify-center w-12 h-12 rounded-xl bg-white border-2 border-gray-200 transition-all duration-300 hover:bg-gray-100 hover:text-gray-900 shadow-md hover:shadow-lg hover:scale-110 focus:outline-none focus:ring-2 focus:ring-[#FF4500] focus:ring-offset-2"
      aria-label="Copy link"
    >
      <svg
        data-copy-icon
        class="w-5 h-5 text-gray-600 group-hover:text-gray-900"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
        ></path>
      </svg>
      <svg
        data-check-icon
        class="w-5 h-5 text-green-600 hidden"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path d="M5 13l4 4L19 7"></path>
      </svg>
    </button>
  </div>
  <p
    data-copied-msg
    class="hidden text-xs text-green-600 text-center mt-2 font-medium"
  >
    Link copied!
  </p>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-share-root]")
    .forEach((root) => {
      const url = window.location.origin + window.location.pathname;
      const title = root.dataset.title ?? document.title;
      const u = encodeURIComponent(url);
      const t = encodeURIComponent(title);

      const links: Record<string, string> = {
        x: `https://twitter.com/intent/tweet?text=${t}&url=${u}`,
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
        whatsapp: `https://wa.me/?text=${t}%20${u}`,
        telegram: `https://t.me/share/url?url=${u}&text=${t}`,
      };

      root.querySelectorAll<HTMLAnchorElement>("[data-share]").forEach((a) => {
        const link = links[a.dataset.share ?? ""];
        if (link) a.href = link;
      });

      const btn = root.querySelector<HTMLButtonElement>("[data-copy]");
      const copyIcon = root.querySelector("[data-copy-icon]");
      const checkIcon = root.querySelector("[data-check-icon]");
      const msg = root.querySelector("[data-copied-msg]");

      btn?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url);
        } catch (err) {
          console.error("Failed to copy link:", err);
          return;
        }
        btn.classList.add("bg-green-50", "border-green-300");
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        msg?.classList.remove("hidden");
        setTimeout(() => {
          btn.classList.remove("bg-green-50", "border-green-300");
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
          msg?.classList.add("hidden");
        }, 2000);
      });
    });
</script>
