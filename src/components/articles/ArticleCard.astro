---
import { Image } from "astro:assets";
import {
  articlesBase,
  formatDate,
  formatNumber,
  getReadingMinutes,
  ui,
  type Article,
} from "../../utils/articles";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const d = article.data;
const t = ui[d.lang];
const minutes = getReadingMinutes(article.body);
---

<a
  href={`${articlesBase(d.lang)}/${article.id}`}
  data-card
  data-tags={d.tags.join("|")}
  data-search={`${d.title} ${d.description}`.toLowerCase()}
  dir={d.lang === "fa" ? "rtl" : "ltr"}
  lang={d.lang}
  class={`${d.lang === "fa" ? "font-fa" : ""} group flex flex-col bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:border-orange-200 focus:outline-none focus:ring-2 focus:ring-[#FF4500] focus:ring-offset-2`}
>
  {
    d.coverImage ? (
      <Image
        src={d.coverImage}
        alt={d.title}
        width={640}
        format="webp"
        class="w-full h-48 object-cover"
      />
    ) : (
      <div
        class="w-full h-48 bg-gradient-to-br from-orange-500 to-red-600 flex items-center justify-center text-white text-5xl font-bold"
        aria-hidden="true"
      >
        {"{ }"}
      </div>
    )
  }
  <div class="flex flex-col flex-1 p-6">
    <div class="flex flex-wrap gap-2 mb-3">
      <span class="text-xs font-semibold text-gray-700 bg-gray-100 px-3 py-1 rounded-full">
        {d.lang === "fa" ? "فارسی" : "English"}
      </span>
      {
        d.tags.map((tag) => (
          <span class="text-xs font-semibold text-orange-600 bg-orange-100 px-3 py-1 rounded-full">
            <bdi dir="ltr">#{tag}</bdi>
          </span>
        ))
      }
    </div>
    <h2
      class="text-xl font-bold text-gray-900 mb-3 leading-snug group-hover:text-[#FF4500] transition-colors duration-300"
    >
      {d.title}
    </h2>
    <p class="text-gray-700 text-base leading-relaxed mb-5 flex-1">
      {d.description}
    </p>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-600">
      <span class="font-medium text-gray-900">{d.author}</span>
      <span aria-hidden="true">•</span>
      <time datetime={d.pubDate.toISOString()}
        >{formatDate(d.pubDate, d.lang)}</time
      >
      <span aria-hidden="true">•</span>
      <span>{formatNumber(minutes, d.lang)} {t.minutes}</span>
    </div>
  </div>
</a>
