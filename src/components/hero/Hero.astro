---
import Container from "../layout/Container.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import socialData from "../../data/social.json";

const social = socialData;
---

<section
  id="hero"
  aria-label="Hero section"
  class="hero relative flex min-h-screen items-center justify-center overflow-hidden pt-16"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-orange-50 via-white via-40% to-red-50"
  >
  </div>

  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-orange-100/40 via-transparent to-transparent"
  >
  </div>

  <div class="absolute inset-0 opacity-[0.03]">
    <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern
          id="hero-grid"
          width="60"
          height="60"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M 60 0 L 0 0 0 60"
            fill="none"
            stroke="#F59E0B"
            stroke-width="1.5"></path>
          <circle cx="0" cy="0" r="2" fill="#F59E0B"></circle>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)"></rect>
    </svg>
  </div>

  <div class="hero-parallax pointer-events-none absolute inset-0 opacity-10">
    <div
      class="absolute left-10 top-20 h-72 w-72 animate-pulse rounded-full bg-gradient-to-br from-orange-400 to-orange-600 blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-20 right-10 h-96 w-96 animate-pulse rounded-full bg-gradient-to-br from-red-400 to-red-600 blur-3xl"
      style="animation-delay: 1s"
    >
    </div>
    <div
      class="absolute left-1/2 top-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 animate-pulse rounded-full bg-gradient-to-br from-amber-300 to-orange-400 blur-3xl"
      style="animation-delay: 2s"
    >
    </div>
  </div>

  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="animate-float absolute left-1/4 top-1/4 h-4 w-4 rounded-full bg-orange-400 opacity-20"
    >
    </div>
    <div
      class="animate-float-delayed absolute right-1/4 top-1/3 h-3 w-3 rounded-full bg-red-400 opacity-30"
    >
    </div>
    <div
      class="animate-float absolute bottom-1/3 left-1/3 h-5 w-5 rounded-full bg-amber-400 opacity-15"
      style="animation-delay: 1.5s"
    >
    </div>
    <div
      class="animate-float-delayed absolute right-1/3 top-1/2 h-2 w-2 rounded-full bg-orange-500 opacity-25"
    >
    </div>
  </div>

  <Container
    class="relative z-10 flex flex-col items-center justify-center py-20 text-center md:py-32"
  >
    <a
      href={social.links.find((link) => link.platform === "Telegram")?.url ??
        "#"}
      target="_blank"
      rel="noopener noreferrer"
      class="hero-reveal mb-10 inline-flex items-center justify-center gap-2 rounded-full border border-gray-200 bg-white px-5 py-2.5 transition-all duration-300 hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#FF4500] focus:ring-offset-2"
    >
      <span class="relative flex h-2.5 w-2.5 shrink-0">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-orange-400 opacity-75"
        ></span>
        <span
          class="relative inline-flex h-2.5 w-2.5 rounded-full bg-orange-500"
        ></span>
      </span>
      <span
        class="whitespace-nowrap text-sm font-semibold text-gray-900 transition-colors duration-300 hover:text-[#FF4500]"
      >
        Join Our Growing Community
      </span>
    </a>

    <h1
      class="hero-reveal hero-delay-1 mb-6 text-6xl font-extrabold leading-[0.9] sm:mb-8 sm:text-7xl md:text-8xl lg:text-9xl"
    >
      <span class="block font-heading text-gray-900">Persia JS</span>
    </h1>

    <p
      class="hero-reveal hero-delay-2 mx-auto mb-10 max-w-3xl text-center text-lg leading-relaxed text-gray-600 md:text-xl lg:text-2xl"
    >
      Empowering the
      <span class="font-semibold text-[#FF4500]">Persian-speaking</span>
      Developer Community
    </p>

    <div
      class="hero-reveal hero-delay-3 mb-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-4 sm:gap-x-8"
    >
      <div class="flex items-center gap-2 text-gray-900">
        <span class="text-sm text-[#FF4500]">●</span>
        <span class="text-sm font-medium md:text-base">500+ Members</span>
      </div>
      <div class="flex items-center gap-2 text-gray-900">
        <span class="text-sm text-[#FF4500]">●</span>
        <span class="text-sm font-medium md:text-base">Monthly Events</span>
      </div>
      <div class="flex items-center gap-2 text-gray-900">
        <span class="text-sm text-[#FF4500]">●</span>
        <span class="text-sm font-medium md:text-base">Expert Speakers</span>
      </div>
    </div>

    <div
      class="hero-reveal hero-delay-4 mb-12 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row sm:gap-6"
    >
      <a
        href="#about"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#FF4500] px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-[#E03D00] focus:outline-none focus:ring-2 focus:ring-[#FF4500] focus:ring-offset-2 sm:w-auto"
      >
        Learn More
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <a
        href="#speakers"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-all duration-300 hover:border-[#FF4500] hover:text-[#FF4500] focus:outline-none focus:ring-2 focus:ring-[#FF4500] focus:ring-offset-2 sm:w-auto"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
          ></path>
        </svg>
        Meet Our Speakers
      </a>
    </div>

    <div
      class="hero-reveal hero-delay-5 flex flex-col items-center justify-center gap-4 sm:flex-row"
    >
      <span class="whitespace-nowrap text-sm font-medium text-gray-600"
        >Connect with us:</span
      >
      <div class="flex gap-3">
        {
          social.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit our ${link.platform} page`}
              class="flex h-10 w-10 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-900 transition-all duration-300 hover:border-[#FF4500] hover:bg-[#FF4500] hover:text-white focus:outline-none focus:ring-2 focus:ring-[#FF4500] focus:ring-offset-2"
            >
              <SocialIcon
                platform={link.icon}
                className="h-4 w-4 sm:h-5 sm:w-5"
              />
            </a>
          ))
        }
      </div>
    </div>
  </Container>

  <a
    href="#about"
    class="absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center rounded-md p-2 text-gray-600 transition-colors duration-300 hover:text-[#FF4500] focus:outline-none focus:ring-2 focus:ring-[#FF4500] focus:ring-offset-2"
    aria-label="Scroll to content"
  >
    <span class="mb-1.5 whitespace-nowrap text-xs font-medium"
      >Scroll to explore</span
    >
    <svg
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </a>

  <div
    class="pointer-events-none absolute left-0 top-0 h-40 w-40 rounded-full bg-gradient-to-br from-orange-200/30 to-transparent blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-0 right-0 h-40 w-40 rounded-full bg-gradient-to-tl from-red-200/30 to-transparent blur-3xl"
  >
  </div>
</section>

<style>
  .hero-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: hero-fade-in 0.8s ease-out forwards;
  }

  .hero-delay-1 {
    animation-delay: 100ms;
  }
  .hero-delay-2 {
    animation-delay: 200ms;
  }
  .hero-delay-3 {
    animation-delay: 300ms;
  }
  .hero-delay-4 {
    animation-delay: 400ms;
  }
  .hero-delay-5 {
    animation-delay: 500ms;
  }

  @keyframes hero-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector(".hero");
  const parallax = hero?.querySelector(".hero-parallax");

  if (
    hero &&
    parallax &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    let frame = 0;

    hero.addEventListener("mousemove", (event) => {
      if (frame) cancelAnimationFrame(frame);

      frame = requestAnimationFrame(() => {
        const x = (event.clientX / window.innerWidth - 0.5) * 20;
        const y = (event.clientY / window.innerHeight - 0.5) * 20;

        parallax.style.transform = `translate(${x}px, ${y}px)`;
        frame = 0;
      });
    });

    hero.addEventListener("mouseleave", () => {
      parallax.style.transform = "translate(0, 0)";
    });
  }
</script>
